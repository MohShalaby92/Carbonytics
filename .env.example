# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/your_database_name
REDIS_URL=redis://redis:6379

# Authentication & Security
# Generate strong random values, e.g. `openssl rand -base64 48`
# In production these are REQUIRED and must be >= 32 chars (the app refuses to start otherwise).
JWT_SECRET=your_access_token_secret_min_32_chars_use_openssl_rand
JWT_REFRESH_SECRET=your_DIFFERENT_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookies (refresh token is delivered as an httpOnly cookie)
# COOKIE_SECURE defaults to true in production. Set COOKIE_DOMAIN if frontend/api are on different subdomains.
COOKIE_SECURE=true
# COOKIE_DOMAIN=.yourdomain.com

# MongoDB Credentials
MONGO_ROOT_USER=your_mongo_admin_username
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGO_INITDB_ROOT_USERNAME=your_mongo_admin_username
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_APP_NAME=Your_App_Name
REACT_APP_VERSION=1.0.0

# File Upload Settings
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
# Stricter limit for /api/auth (login/register/refresh) to slow brute-force
AUTH_RATE_LIMIT_MAX=10

# CORS & Client Configuration
CLIENT_URL=http://localhost:3000

# Cache Configuration
CACHE_TTL=3600

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true

# Grafana Configuration
GRAFANA_PASSWORD=your_secure_grafana_password_here
