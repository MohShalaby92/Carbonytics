      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-brand\">Carbonytics</span><a class=\"ds-nav-link\" href=\"#\">Dashboard</a><a class=\"ds-nav-link\" href=\"#\">Calculate</a><a class=\"ds-nav-link\" href=\"#\">Compliance</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:8px;padding:12px 24px;background:rgb(var(--surface) / .8);backdrop-filter:blur(8px);border-bottom:1px solid rgb(var(--line))}.ds-nav-brand{margin-inline-end:16px;font:600 1.125rem/1 Archivo,ui-sans-serif,system-ui,sans-serif;font-stretch:112.5%;letter-spacing:-.01em;color:rgb(var(--fg))}.ds-nav-link{padding:8px 12px;border-radius:.5rem;color:rgb(var(--fg) / .8);font:500 .875rem/1 'Hanken Grotesk',system-ui,sans-serif;text-decoration:none;transition:background 150ms}.ds-nav-link:hover{background:rgb(var(--fg) / .05);color:rgb(var(--fg))}.ds-nav-link:focus-visible{outline:none;box-shadow:0 0 0 2px rgb(var(--ring))}"
    }
