  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action per surface; forest in Verdant, mint in Console.",
      "html": "<button class=\"ds-btn-primary\">Save calculation</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border-radius:0.875rem;font:600 0.875rem/1 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer;transition:all 150ms;border:none;background:rgb(var(--brand));color:rgb(var(--brand-fg));box-shadow:0 1px 2px rgba(16,24,20,0.04),0 8px 24px -12px rgba(16,24,20,0.12)}.ds-btn-primary:hover{opacity:.9}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px rgb(var(--bg)),0 0 0 4px rgb(var(--ring))}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions beside a primary.",
      "html": "<button class=\"ds-btn-secondary\">Export</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border-radius:0.875rem;font:600 0.875rem/1 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer;transition:all 150ms;border:1px solid rgb(var(--line));background:rgb(var(--surface));color:rgb(var(--fg))}.ds-btn-secondary:hover{background:rgb(var(--fg) / .04)}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 2px rgb(var(--bg)),0 0 0 4px rgb(var(--ring))}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis inline actions and toolbars.",
      "html": "<button class=\"ds-btn-ghost\">Reset</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border-radius:0.875rem;font:600 0.875rem/1 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer;transition:all 150ms;border:none;background:transparent;color:rgb(var(--fg) / .8)}.ds-btn-ghost:hover{background:rgb(var(--fg) / .06);color:rgb(var(--fg))}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 2px rgb(var(--bg)),0 0 0 4px rgb(var(--ring))}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive actions only.",
      "html": "<button class=\"ds-btn-danger\">Delete vehicle</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border-radius:0.875rem;font:600 0.875rem/1 'Hanken Grotesk',system-ui,sans-serif;cursor:pointer;transition:all 150ms;border:none;background:#dc2626;color:#fff;box-shadow:0 1px 2px rgba(16,24,20,0.04),0 8px 24px -12px rgba(16,24,20,0.12)}.ds-btn-danger:hover{background:#b91c1c}.ds-btn-danger:focus-visible{outline:none;box-shadow:0 0 0 2px rgb(var(--bg)),0 0 0 4px rgb(var(--ring))}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "All single-line fields; accent border and ring on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Enter kWh consumed\" />",
      "css": ".ds-input{display:block;width:100%;max-width:320px;padding:10px 14px;border:1px solid rgb(var(--line));border-radius:0.875rem;background:rgb(var(--surface));color:rgb(var(--fg));font:400 0.875rem/1.4 'Hanken Grotesk',system-ui,sans-serif;box-shadow:0 1px 2px rgba(0,0,0,.05);transition:border-color 150ms,box-shadow 150ms}.ds-input::placeholder{color:rgb(var(--muted))}.ds-input:focus{outline:none;border-color:rgb(var(--accent));box-shadow:0 0 0 2px rgb(var(--accent) / .3)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Default container for every panel.",
      "html": "<div class=\"ds-card\"><h3 class=\"ds-card-title\">Scope 2</h3><p class=\"ds-card-body\">966.38 kg CO₂e, location-based</p></div>",
      "css": ".ds-card{max-width:320px;padding:24px;border:1px solid rgb(var(--line));border-radius:1.125rem;background:rgb(var(--surface));box-shadow:0 1px 2px rgba(16,24,20,0.04),0 8px 24px -12px rgba(16,24,20,0.12)}.ds-card-title{margin:0 0 4px;font:600 1.125rem/1.5 Archivo,ui-sans-serif,system-ui,sans-serif;font-stretch:112.5%;letter-spacing:-.01em;color:rgb(var(--fg))}.ds-card-body{margin:0;font:400 .875rem/1.45 'Hanken Grotesk',system-ui,sans-serif;color:rgb(var(--fg) / .8)}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Real status only: verified, locked, warning, error.",
      "html": "<span class=\"ds-badge ds-badge-success\">Verified</span> <span class=\"ds-badge\">Draft</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:4px 10px;border:1px solid rgb(var(--line));border-radius:9999px;background:rgb(var(--fg) / .06);color:rgb(var(--fg) / .7);font:600 .875rem/1.2 'Hanken Grotesk',system-ui,sans-serif}.ds-badge-success{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.2);color:#047857}"
    },
    {
      "name": "Navbar",
      "kind": "nav",
