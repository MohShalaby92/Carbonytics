# =============================================================================
# Carbonytics — SPECIALIST-REVIEW environment template
# =============================================================================
# Copy this file to `.env.review` (gitignored) and replace every CHANGE_ME.
# Compose loads it into the mongo / redis / backend containers via `env_file:`
# in docker-compose.review.yml. This slim review stack has NO monitoring, so the
# Grafana/exporter variables from .env.production are intentionally omitted.
#
# Generate strong secrets with:   openssl rand -base64 48
# EXCEPTION: passwords embedded in a connection URI (MONGO_APP_PASSWORD and
# REDIS_PASSWORD) must be URL-safe — use hex:   openssl rand -hex 32
# Never commit the filled-in .env.review. Never reuse the dev secrets.
#
# NOTE: DISABLE_REGISTRATION=true is set in docker-compose.review.yml (not here)
# so the public signup endpoint is always closed on this instance. Accounts are
# created with scripts/seedReviewAccounts.ts.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production

# --- JWT (the app REFUSES to start if these are missing, < 32 chars, or weak) -
# Two DISTINCT secrets. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_access_secret_min_32_chars_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_refresh_secret_min_32_chars_openssl

# --- Cookies / CORS ---------------------------------------------------------
# Public https origin of the review instance — your DuckDNS hostname.
# Used for CORS and the Secure; SameSite=Strict refresh cookie.
CLIENT_URL=https://carbonytics.duckdns.org

# --- MongoDB ----------------------------------------------------------------
# Root credentials bootstrap auth + the init script on first boot.
MONGO_INITDB_ROOT_USERNAME=carbonytics_root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_mongo_root_password

# Least-privilege application user (readWrite on the app db only). The backend
# connects as THIS user. URL-safe password (openssl rand -hex 32) — it is also
# embedded in MONGODB_URI below and MUST match.
MONGO_APP_USERNAME=carbonytics_app
MONGO_APP_PASSWORD=CHANGE_ME_url_safe_mongo_app_password
MONGO_APP_DB=carbonytics_prod

# Backend connection string — the password must equal MONGO_APP_PASSWORD above.
MONGODB_URI=mongodb://carbonytics_app:CHANGE_ME_url_safe_mongo_app_password@mongo:27017/carbonytics_prod?authSource=carbonytics_prod

# --- Redis ------------------------------------------------------------------
# REDIS_PASSWORD sets requirepass on the container; REDIS_URL is what the backend
# reads (password embedded). URL-safe value (openssl rand -hex 32), keep in sync.
REDIS_PASSWORD=CHANGE_ME_url_safe_redis_password
REDIS_URL=redis://:CHANGE_ME_url_safe_redis_password@redis:6379

# --- Backups (automated mongodump sidecar) ----------------------------------
# Dumps once on start then every BACKUP_INTERVAL seconds (86400 = daily), keeping
# BACKUP_RETENTION_DAYS days of gzipped archives in ./backups.
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
