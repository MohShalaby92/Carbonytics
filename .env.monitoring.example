# =============================================================================
# Carbonytics — MONITORING environment template (Prometheus exporters)
# =============================================================================
# Copy to `.env.monitoring` (gitignored) and fill in. This file is read ONLY by
# the metrics exporters in docker-compose.prod.yml, deliberately kept separate
# from .env.production so application/JWT secrets never reach the exporters.
#
# Generate URL-safe values with: openssl rand -hex 32
# =============================================================================

# --- mongodb_exporter -------------------------------------------------------
# Connection URI for the monitoring user created by mongo/init/01-app-user.sh
# (MONGO_EXPORTER_USERNAME/PASSWORD in .env.production). It has clusterMonitor on
# admin, so authSource=admin. The password MUST equal MONGO_EXPORTER_PASSWORD.
MONGODB_URI=mongodb://carbonytics_monitor:CHANGE_ME_url_safe_mongo_monitor_password@mongo:27017/?authSource=admin

# --- redis_exporter ---------------------------------------------------------
# REDIS_PASSWORD must equal the value in .env.production (same redis instance).
REDIS_ADDR=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_url_safe_redis_password
