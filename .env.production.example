# =============================================================================
# Carbonytics — PRODUCTION environment template
# =============================================================================
# Copy this file to `.env.production` (which is gitignored) and replace every
# CHANGE_ME with a real value. Compose loads it into the mongo / redis / backend
# / grafana containers via `env_file:` in docker-compose.prod.yml.
#
# Generate strong secrets with:   openssl rand -base64 48
# Never commit the filled-in .env.production. Never reuse the dev secrets.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production

# --- JWT (the app REFUSES to start in production if these are missing, shorter
#     than 32 chars, or a known weak value — see backend/src/config/config.ts) -
# Two DISTINCT secrets: one for short-lived access tokens, one for refresh.
JWT_SECRET=CHANGE_ME_access_secret_min_32_chars_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_refresh_secret_min_32_chars_openssl

# --- Cookies / CORS ---------------------------------------------------------
# The refresh token is delivered as an httpOnly cookie. COOKIE_SECURE=true is
# set in docker-compose.prod.yml (HTTPS only). CLIENT_URL must be the public
# https origin (used for CORS + Set-Cookie). Set COOKIE_DOMAIN only if the SPA
# and API are served from different subdomains.
CLIENT_URL=https://carbonytics.example.com
# COOKIE_DOMAIN=.carbonytics.example.com

# --- MongoDB ----------------------------------------------------------------
# Root credentials bootstrap auth on first boot (used only by the init script).
MONGO_INITDB_ROOT_USERNAME=carbonytics_root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_mongo_root_password

# Least-privilege application user (created by mongo/init/01-app-user.sh on the
# carbonytics_prod database with readWrite only). The backend connects as THIS
# user, never as root.
MONGO_APP_USERNAME=carbonytics_app
MONGO_APP_PASSWORD=CHANGE_ME_strong_mongo_app_password
MONGO_APP_DB=carbonytics_prod

# Backend connection string — must match the app user above. authSource is the
# database the app user was created in (carbonytics_prod).
MONGODB_URI=mongodb://carbonytics_app:CHANGE_ME_strong_mongo_app_password@mongo:27017/carbonytics_prod?authSource=carbonytics_prod

# --- Redis ------------------------------------------------------------------
# Password-protected. The backend reads only REDIS_URL (it does not read
# REDIS_PASSWORD separately), so the password is embedded in the URL. The redis
# container reads REDIS_PASSWORD to set requirepass.
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# --- Grafana (monitoring dashboard at host :3001) ---------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# --- Backups (automated mongodump sidecar — see SI-5) -----------------------
# Cron schedule (UTC) for the backup sidecar and how many days of dumps to keep.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
